# Copy to .env and fill in. .env is git-ignored.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True

# Include the LAN IP so a phone on the same network can reach the API.
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.18.8

# Local development: a zero-configuration SQLite database.
DATABASE_URL=sqlite:///db.sqlite3
# Production PostgreSQL example (replace with a public/reachable provider URL):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Media storage.
# True  -> files land in ./media and file_path is built from this server's host.
# False -> files land in Backblaze B2 and file_path is the direct public B2 url.
USE_LOCAL_MEDIA=True

# Backblaze B2, via its S3-compatible API. Only read when USE_LOCAL_MEDIA=False.
# B2_ENDPOINT and B2_REGION both come from the bucket's "Endpoint" in the B2 console:
# s3.us-west-004.backblazeb2.com -> region us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# Optional CDN/custom domain in front of the bucket. Leave blank to serve straight from B2.
B2_CDN_DOMAIN=

# --- Production (Railway) ------------------------------------------------
# These are NOT read from this file in production. Railway has no .env: set each
# one under Service -> Variables. Listed here so the full set is in one place.
#
#   SECRET_KEY            a fresh long random string, never the local one
#                         python -c "import secrets; print(secrets.token_urlsafe(64))"
#   DEBUG                 False
#   ALLOWED_HOSTS         your custom domain, comma separated. The Railway
#                         domain and its health-check host are added
#                         automatically from RAILWAY_PUBLIC_DOMAIN, so this can
#                         be left unset if you only use the *.up.railway.app url.
#   CSRF_TRUSTED_ORIGINS  https://your-custom-domain.com  (scheme required).
#                         The Railway domain is added automatically.
#   DATABASE_URL          reference Railway's Postgres, do not paste a literal:
#                         ${{ Postgres.DATABASE_URL }}
#   USE_LOCAL_MEDIA       False. Railway's filesystem is ephemeral - anything
#                         uploaded through the admin is lost on the next deploy,
#                         so production must store media in B2.
#   B2_ENDPOINT           https://s3.us-west-004.backblazeb2.com
#   B2_REGION             us-west-004
#   B2_KEY_ID             from the B2 console
#   B2_APP_KEY            from the B2 console
#   B2_BUCKET             bucket name; the bucket must be PUBLIC
#   B2_CDN_DOMAIN         optional
#
# RAILWAY_PUBLIC_DOMAIN and PORT are injected by Railway. Do not set them.
